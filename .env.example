# URL base da API do SimCC/Observatório para busca e indicadores
VITE_API_URL=https://observatoriocti.secti.ba.gov.br/simcc/api

# URL base do Observatório IdP (Single Sign-On / OIDC PKCE)
VITE_IDP_URL=https://observatoriocti.secti.ba.gov.br/idp/

# SimCC ETL — relatórios de consistência das cargas (tela /verificacao-consistencia)
VITE_ETL_URL=https://simcc.uesc.br/etl

# Chave do endpoint de exportação do ETL (header X-ETL-API-Key).
# ATENÇÃO: variáveis VITE_* ficam embutidas no bundle público do site.
# O ETL liberou CORS para o domínio do portal e o endpoint é somente leitura;
# o risco está documentado no PR. O ideal é intermediar por um proxy no backend.
VITE_ETL_API_KEY=

# Onde estão as fotos por instituição (index.json + arquivos).
# Padrão: branch dados-snapshots do repositório público, via raw.githubusercontent.
# Para usar uma pasta local, aponte para /snapshots e rode `npm run snapshots -- --saida public/snapshots`.
VITE_SNAPSHOTS_URL=https://raw.githubusercontent.com/observatorio-secti/observatorio-front/dados-snapshots

# Só no `npm run dev`: abre /verificacao-consistencia sem passar pelo IdP
# (útil quando o SSO local não está no ar). Ignorado em build de produção.
# VITE_AUTH_DESLIGADA=true
